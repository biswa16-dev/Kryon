# ==============================================================================
# Kryon - Environment Variables Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# RAG Ingestion & Chunking
DATA_DIR=data/raw
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Retrieval & Re-ranking Defaults
SEARCH_MODE=hybrid
TOP_K=5
USE_RERANKER=true
CONFIDENCE_THRESHOLD=0.50

# Local LLM Integration (Ollama - Optional / Self-Hosted)
# Leave as default if running Ollama locally, or set to your self-hosted instance
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
