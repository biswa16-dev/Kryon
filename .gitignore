# ==============================================================================
# Kryon - Git Ignore
# ==============================================================================

# Environment variables & secrets (CRITICAL: protects SMTP_USER, SMTP_PASSWORD, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET)
.env
.env*
*.env
*.env.*
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
client_secret*.json
credentials*.json
*.pem
*.key

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~

# Operating System artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor files
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Type checking & linter caches
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Distribution / Packaging
build/
dist/
eggs/
.eggs/
*.egg-info/
*.egg

# Large Model Weights (exceeds GitHub 100MB limit; train locally with python -m src.training.train)
*.safetensors
*.bin
*.pt
*.pth
*.onnx

# Local test scratchpad & Firebase CLI cache
scratch/
.firebase/


